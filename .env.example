# NEXACK 2K26 - Root Environment Template

# --- Backend Configuration ---
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/nexack_2k26
JWT_SECRET=your_super_secret_jwt_key_2k26_production
JWT_EXPIRE=7d

# Initial Super Admin Provisioning (Created via `node scripts/seedInitial.js`)
ADMIN_NAME=Nexora Super Admin
ADMIN_EMAIL=admin@nexack.com
ADMIN_PASSWORD=Admin@Nexack2K26

# Optional: Cloudinary CDN (Local uploads fallback in backend/uploads if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frontend Configuration ---
VITE_API_URL=http://localhost:5000/api/v1
